# Root .env.example — documents all environment variables across services.
# Copy the relevant section into each service's .env file.
# Never commit real secrets.

# ═══════════════════════════════════════════════════════════════════════════════
# services/api/.env  —  Core FastAPI API
# ═══════════════════════════════════════════════════════════════════════════════

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://anchor:anchor_dev_password@localhost:5433/anchor_db

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# JWT — Ed25519 keypair
# Generate once: cd services/api && python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; ..."
# Or: .\scripts.ps1 gen-keys  (from services/api/)
JWT_PRIVATE_KEY_PATH=.keys/ed25519_private.pem
JWT_PUBLIC_KEY_PATH=.keys/ed25519_public.pem

# Password pepper — 32-byte random hex. NEVER change after users are created.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_PEPPER=REPLACE_WITH_64_HEX_CHARS

# App secret (CSRF, session signing)
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS

# Environment: development | production
ENVIRONMENT=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000

# RAG service (Phase 3 — set after services/rag is deployed)
RAG_SERVICE_URL=http://localhost:8001
RAG_INTERNAL_SECRET=REPLACE_WITH_64_HEX_CHARS

# Firebase Cloud Messaging (optional — push notifications disabled if unset)
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_JSON_PATH=/path/to/firebase-adminsdk.json

# Email delivery — Brevo (primary)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your@email.com
BREVO_SENDER_NAME=Anchor AI

# Email delivery — Gmail SMTP (fallback)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# SMS gateway (optional)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=AnchorAI

# LLM (used by timetable NL-edit endpoint — proxy to RAG service for chat)
OLLAMA_BASE_URL=http://localhost:11434

# Password breach check (HaveIBeenPwned API)
HIBP_CHECK_ENABLED=false

# Set true to skip 400 MB sentence-transformer model load on startup
# Use on memory-constrained deployments (Railway free tier, etc.)
DISABLE_AI_WARMUP=false


# ═══════════════════════════════════════════════════════════════════════════════
# services/rag/.env  —  RAG Service
# ═══════════════════════════════════════════════════════════════════════════════

# Ollama endpoint (model: qwen3:1.7b or qwen3:8b)
# OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB vector store path (relative to working directory)
# CHROMADB_PATH=data/chromadb

# Shared internal secret — must match services/api RAG_INTERNAL_SECRET
# RAG_INTERNAL_SECRET=REPLACE_WITH_64_HEX_CHARS

# Skip sample corpus warmup on startup
# DISABLE_AI_WARMUP=false


# ═══════════════════════════════════════════════════════════════════════════════
# apps/student/env.js  (gitignored — copy from env.example.js)
# ═══════════════════════════════════════════════════════════════════════════════
# Values from Firebase Console → Project Settings → Your Apps (web app)
# and → Cloud Messaging → Web Push certificates (VAPID key)
# See apps/student/env.example.js for the exact format.
