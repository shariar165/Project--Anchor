# Database
DATABASE_URL=postgresql+asyncpg://anchor:anchor_dev_password@localhost/anchor_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — Ed25519 keys (generate with: make gen-keys)
JWT_PRIVATE_KEY_PATH=.keys/ed25519_private.pem
JWT_PUBLIC_KEY_PATH=.keys/ed25519_public.pem

# Password pepper — 32-byte hex (generate: python -c "import secrets; print(secrets.token_hex(32))")
PASSWORD_PEPPER=REPLACE_WITH_64_HEX_CHARS

# App
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@anchor.example.com
BREVO_SENDER_NAME=Anchor AI

# SMS gateway
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=AnchorAI

# HIBP — set to false to skip during tests
HIBP_CHECK_ENABLED=true

# ── AI providers ──────────────────────────────────────────────────────────────
# Chain for the API's own AI features (notice drafting, routine/timetable NL edits):
# Ollama (primary) → Gemini → Groq → templated output. Same keys power the RAG chatbot
# (configured separately in services/rag/.env).

# 1) Ollama (primary) — direct LAN/localhost address, NOT ngrok/cloudflare.
OLLAMA_BASE_URL=http://localhost:11434

# 2) Gemini — best-effort cloud fallback. Prefer a PERMANENT "AIza…" key from
# https://aistudio.google.com/apikey. "AQ.…" OAuth tokens work but expire within hours.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3) Groq (OpenAI-compatible) — reliable cloud fallback. Keys from
# https://console.groq.com/keys (look like gsk_…).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# RAG service (the /ai/chat proxy target). Secret MUST match services/rag/.env.
RAG_SERVICE_URL=http://localhost:8001
RAG_INTERNAL_SECRET=REPLACE_WITH_64_HEX_CHARS
