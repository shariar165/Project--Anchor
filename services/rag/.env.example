# ─────────────────────────────────────────────────────────────
# RAG service — local run config (Option B: RAG on your PC, API on Railway)
# Copy to .env and fill in. The Railway API reaches this service via ngrok.
# ─────────────────────────────────────────────────────────────

# Shared secret — MUST be byte-for-byte identical to RAG_INTERNAL_SECRET
# set on the Railway *API* service. The API sends it as X-Internal-Secret;
# RAG rejects (403) any request whose secret doesn't match.
RAG_INTERNAL_SECRET=paste-the-same-secret-you-set-on-the-railway-api

# Ollama (the answer generator). Runs on this same PC, so localhost is correct.
# Start Ollama BEFORE starting this service so warm-up/ingestion can reach it.
OLLAMA_BASE_URL=https://unwell-pang-word.ngrok-free.dev

# Gemini (Google Generative Language API) — PRIMARY generator when set. The pipeline
# calls Gemini first and only falls back to Ollama above if Gemini is unreachable.
# Get a key from https://aistudio.google.com/apikey (keys look like AIza...).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ChromaDB vector store location (persistent on your PC — unlike Railway).
CHROMADB_PATH=data/chromadb

# Leave warm-up ENABLED locally: on first start it loads the sample legal
# corpus into the `national` ChromaDB namespace so retrieval has data.
# (On Railway we set this true to avoid OOM — locally we WANT it false.)
DISABLE_AI_WARMUP=false
