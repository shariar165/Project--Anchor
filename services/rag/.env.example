# ─────────────────────────────────────────────────────────────
# RAG service — local run config (Option B: RAG on your PC, API on Railway)
# Copy to .env and fill in. The Railway API reaches this service via ngrok.
# ─────────────────────────────────────────────────────────────

# Shared secret — MUST be byte-for-byte identical to RAG_INTERNAL_SECRET
# set on the Railway *API* service. The API sends it as X-Internal-Secret;
# RAG rejects (403) any request whose secret doesn't match.
RAG_INTERNAL_SECRET=paste-the-same-secret-you-set-on-the-railway-api

# Provider order: Ollama (primary) → Gemini → Groq → deterministic stub.
# Each is tried in turn; the first that answers wins. A failed provider is skipped
# for a short cooldown so failover stays instant.

# 1) Ollama (primary). Use a direct LAN/localhost address — NOT ngrok/cloudflare.
# Start Ollama (with qwen3:1.7b pulled) BEFORE this service so warm-up can reach it.
OLLAMA_BASE_URL=http://192.168.0.111:11434

# 2) Gemini — best-effort cloud fallback when set. Prefer a PERMANENT "AIza…" key from
# https://aistudio.google.com/apikey. "AQ.…" OAuth tokens work but expire within hours.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3) Groq (OpenAI-compatible) — reliable cloud fallback. Permanent gsk_ keys from
# https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Dense embedder (fastembed, ONNX — no torch). Must be a multilingual model that
# covers Bangla. Default is the smallest such model (~0.22 GB) to fit Railway's
# free tier. Leave unset to use the default.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# In-memory numpy vector store persistence dir (replaces ChromaDB).
VECTOR_STORE_PATH=data/vectors

# Optional: baked fastembed model cache dir. The Dockerfile sets this so the
# model ships in the image instead of downloading at runtime. Leave blank locally.
# FASTEMBED_CACHE_PATH=

# Leave warm-up ENABLED locally: on first start it re-embeds the sample legal
# corpus into the `national` namespace so retrieval has data.
# (On Railway, warm-up now fits in RAM — keep it enabled unless you bake a
# prebuilt data/vectors store into the image.)
DISABLE_AI_WARMUP=false
